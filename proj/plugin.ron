(
    name: "Project Opener",
    description: "Open a project from ~/projects\nproj <filter>: PhpStorm, projc <filter>: Claude (Remote Control)",
    bin: (path: "proj.py"),
    icon: Name("phpstorm"),
    query: (
        regex: "^projc?\\b.*",
        help: "proj / projc ",
        priority: High,
    ),
    history: false,
)
